# ---- Server ----
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# ---- Database (local Docker default) ----
DATABASE_URL=postgres://schedulnyx:schedulnyx_dev@localhost:5432/schedulnyx

# ---- Firebase Admin (server-side JWT verification) ----
# Leave blank in dev to use the x-dev-uid header instead of real tokens.
# Option A (recommended): paste the full service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT=
# Option B: provide the three fields individually instead of the JSON above.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the service-account private key. Newlines may be escaped as \n.
FIREBASE_PRIVATE_KEY=

# Set DEV_AUTH=false to disable the x-dev-uid dev login even outside production.
DEV_AUTH=true

# ---- Gemini ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
